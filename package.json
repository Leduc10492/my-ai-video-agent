{
  "name": "my-ai-video-agent-workflow",
  "version": "1.0.0",
  "private": true,
  "description": "File-based AI video workflow validation and screenplay DOCX export.",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "scripts": {
    "validate": "node .agents/skills/qa-workflow/scripts/validate-repository.mjs",
    "export:screenplay": "node .agents/skills/screenwriter-workflow/scripts/export_screenplay_docx.js",
    "workflow": "node .agents/skills/version-management/scripts/workflow-state.mjs",
    "test:workflow": "node --test .agents/skills/version-management/tests/local-script-workflow.test.mjs",
    "workbench:dev": "pnpm --dir workbench dev",
    "workbench:build": "pnpm --dir workbench build",
    "workbench:start": "pnpm --dir workbench start",
    "workbench:test": "pnpm --dir workbench test",
    "workspace:context": "node workbench/scripts/project-context.mjs",
    "workspace:migrate": "node workbench/scripts/migrate-workspace.mjs",
    "workspace:publish": "node workbench/scripts/publish-workspace.mjs"
  },
  "dependencies": {
    "docx": "^9.7.1"
  }
}
